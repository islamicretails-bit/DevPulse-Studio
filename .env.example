# =======================================================
# DevPulse Studio Pro - Environment Variables Blueprint
# =======================================================

# -------------------------------------------------------
# Primary LLM API Keys (Groq Key Rotation Pool)
# Multi-engine rotation for lightning-fast concurrent builds
# -------------------------------------------------------
GROQ_API_KEY_1=gsk_your_groq_key_1_here
GROQ_API_KEY_2=gsk_your_groq_key_2_here
GROQ_API_KEY_3=gsk_your_groq_key_3_here
GROQ_API_KEY_4=gsk_your_groq_key_4_here
GROQ_API_KEY_5=gsk_your_groq_key_5_here

# Standard single key fallback
GROQ_API_KEY=gsk_your_default_groq_api_key_here

# -------------------------------------------------------
# Fallback & Parallel LLM Keys (Gemini Key Rotation Pool)
# Uses gemini-1.5-flash / gemini-1.5-pro (No 404 Error)
# -------------------------------------------------------
GEMINI_API_KEY_1=AIzaSy_your_gemini_key_1_here
GEMINI_API_KEY_2=AIzaSy_your_gemini_key_2_here
GEMINI_API_KEY_3=AIzaSy_your_gemini_key_3_here
GEMINI_API_KEY_4=AIzaSy_your_gemini_key_4_here
GEMINI_API_KEY_5=AIzaSy_your_gemini_key_5_here
GEMINI_API_KEY_6=AIzaSy_your_gemini_key_6_here

# Standard single key fallback
GEMINI_API_KEY=AIzaSy_your_default_gemini_api_key_here

# -------------------------------------------------------
# Secondary Fallback API Keys (OpenAI Key Pool - Optional)
# Used if both Groq and Gemini pools are exhausted
# -------------------------------------------------------
OPENAI_API_KEY_1=sk-proj-your_primary_openai_key_here
OPENAI_API_KEY_2=sk-proj-your_secondary_openai_key_here
OPENAI_API_KEY=sk-proj-your_default_openai_key_here

# -------------------------------------------------------
# Global Engine Runtime Configurations (Parallel Multithreading)
# -------------------------------------------------------
# Maximum files generated simultaneously (Recommended: 5)
ENGINE_MAX_WORKERS=5

# Cooldown between requests in milliseconds
ENGINE_REQUEST_COOLDOWN_MS=1000

# Enable automatic engine self-healing & API key rotation
ENGINE_AUTO_HEAL=true

# Force complete code generation without placeholders or shortcuts
ENGINE_STRICT_NO_TRUNCATION=true

# Target Gemini model version (Prevents 404 model errors)
GEMINI_MODEL_NAME=gemini-1.5-flash
