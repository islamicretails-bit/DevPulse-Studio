# =======================================================
# DevPulse Studio Pro - Environment Variables Blueprint
# =======================================================

# -------------------------------------------------------
# Primary LLM API Keys (Groq Key Rotation Pool)
# Add multiple keys for automatic rate-limit failover
# -------------------------------------------------------
GROQ_API_KEY_1=gsk_your_primary_groq_api_key_here
GROQ_API_KEY_2=gsk_your_secondary_groq_api_key_here
GROQ_API_KEY_3=gsk_your_tertiary_groq_api_key_here

# Standard single key fallback (used if numbered keys are absent)
GROQ_API_KEY=gsk_your_default_groq_api_key_here

# -------------------------------------------------------
# Fallback LLM API Keys (OpenAI Key Pool)
# Used when Groq keys hit daily rate limits or outages
# -------------------------------------------------------
OPENAI_API_KEY_1=sk-proj-your_primary_openai_key_here
OPENAI_API_KEY_2=sk-proj-your_secondary_openai_key_here

# Standard single key fallback
OPENAI_API_KEY=sk-proj-your_default_openai_key_here

# -------------------------------------------------------
# Global Engine Runtime Configurations
# -------------------------------------------------------
ENGINE_MAX_WORKERS=3
ENGINE_REQUEST_COOLDOWN_MS=1500
ENGINE_AUTO_HEAL=true
ENGINE_STRICT_NO_TRUNCATION=true
