{
  "name": "devpulse-studio-pro",
  "version": "1.0.0",
  "description": "Enterprise Multi-Agent AI System for Full-Stack Software Generation",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "cli": "ts-node packages/cli/src/index.ts",
    "example": "ts-node examples/build-platform.ts",
    "clean": "rimraf node_modules packages/*/node_modules apps/*/node_modules dist packages/*/dist apps/*/dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
